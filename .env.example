# Rotate and replace all values before committing any deployment.
# Do NOT commit the real .env — it is gitignored.

# --- Groq (required for AI features) ---
GROQ_API_KEY=replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# --- Tavily (required for web research) ---
TAVILY_API_KEY=replace_me

# --- Spotify OAuth (optional; required only for music features) ---
SPOTIFY_CLIENT_ID=replace_me
SPOTIFY_CLIENT_SECRET=replace_me
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
# SPOTIFY_COOKIE_SECURE defaults to true. Set to false only for local HTTP dev.
# SPOTIFY_COOKIE_SECURE=false
# Fernet key for encrypting stored Spotify tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SPOTIFY_TOKEN_ENCRYPTION_KEY=replace_me

# --- App / auth ---
# JWT_SECRET is required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=replace_me

# --- Tuning ---
MAX_SEARCH_RESULTS=6
MAX_FILE_TEXT_CHARS=12000
MAX_UPLOAD_BYTES=10485760

# --- Rate limits (slowapi syntax) ---
# RATE_LIMIT_AUTH=5/minute
# RATE_LIMIT_UPLOAD=10/minute
# RATE_LIMIT_AI=10/minute
# RATE_LIMIT_SPOTIFY=60/minute
# RATE_LIMIT_DEFAULT=120/minute

# --- CORS (comma-separated) ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
